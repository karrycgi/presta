# Default country configured on PrestaShop installation
COUNTRY=fr
# Default laguage configured on PrestaShop installation
LANGUAGE=en
# Image to be used for PrestaShop container
PRESTA_IMG=prestashop/prestashop:9.0.3
# Image to be used for MySQL container
MYSQL_IMG=mysql:5.7
# Image to be used for Composer container
COMPOSER_IMG=composer:2.9.5