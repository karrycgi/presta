{
  "name": "mypresta",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "e2e-cypress"
  ],
  "scripts": {
    "env:setup": "cp default.env .env",
    "up": "docker compose pull && docker compose -f docker-compose.dev.yml -f docker-compose.yml up -d",
    "up:test": "docker compose pull && docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f prestashop",
    "clean:cypress": "rimraf ./e2e-cypress/cypress/videos/* && rimraf ./e2e-cypress/cypress/screenshots/*",
    "test": "npm run test --workspaces=e2e-cypress",
    "cypress:open": "npm run open --workspaces=e2e-cypress",
    "clean": "npm run clean:data && npm run clean:vendor",
    "clean:data": "rimraf ./data/*",
    "clean:vendor": "rimraf ./ipgcheckout/vendor",
    "rm:install": "docker compose exec prestashop rm -R /var/www/html/install",
    "composer:install": "docker compose run --remove-orphans --build composer install --no-dev",
    "composer:install:dev": "docker compose run --remove-orphans --build composer install",
    "composer:update":  "docker compose run --remove-orphans --build composer update",
    "composer:version": "docker compose run --remove-orphans --build composer --version",
    "zip": "npm run composer:install && zip -r ipgcheckout.zip ipgcheckout && npm run composer:install:dev"
  },
  "dependencies": {
    "rimraf": "^6.0.1"
  }
}